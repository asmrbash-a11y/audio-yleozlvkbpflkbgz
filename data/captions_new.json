[
 {
  "start": 0.0,
  "end": 3.0,
  "text": "في عام 1971 بدأت"
 },
 {
  "start": 3.32,
  "end": 4.98,
  "text": "واحدة من أغرب قصص"
 },
 {
  "start": 5.0,
  "end": 7.02,
  "text": "النجاة في تاريخ الطيران"
 },
 {
  "start": 7.32,
  "end": 9.5,
  "text": "كانت جوليان كوبكة فتاة"
 },
 {
  "start": 9.52,
  "end": 10.48,
  "text": "تبلغ من العمر 17"
 },
 {
  "start": 10.5,
  "end": 12.54,
  "text": "عاماً تستقل طائرة"
 },
 {
  "start": 12.56,
  "end": 14.72,
  "text": "برفقة والدتها فوق غابات"
 },
 {
  "start": 14.74,
  "end": 17.3,
  "text": "الأمازون في بيرو وفجأة"
 },
 {
  "start": 17.32,
  "end": 19.22,
  "text": "تحولت الرحلة الهادئة"
 },
 {
  "start": 19.24,
  "end": 21.34,
  "text": "إلى كابوس ضرب البرق"
 },
 {
  "start": 21.36,
  "end": 23.76,
  "text": "الطائرة وعصفت عاصفة عنيفة"
 },
 {
  "start": 23.78,
  "end": 25.68,
  "text": "فانفصل جناحها وبدأت"
 },
 {
  "start": 25.7,
  "end": 27.66,
  "text": "تتفكك في السماء وفي"
 },
 {
  "start": 27.68,
  "end": 29.76,
  "text": "لحظات وجدت جوليان نفسها"
 },
 {
  "start": 29.78,
  "end": 31.44,
  "text": "تسقط من ارتفاع يقارب"
 },
 {
  "start": 31.46,
  "end": 33.62,
  "text": "ثلاثة آلاف متر وهي"
 },
 {
  "start": 33.64,
  "end": 35.48,
  "text": "لا تزال مربوطة بمقعدها"
 },
 {
  "start": 35.5,
  "end": 37.58,
  "text": "لكن المعجزة"
 },
 {
  "start": 37.6,
  "end": 39.56,
  "text": "حدثت استيقظت في اليوم"
 },
 {
  "start": 39.58,
  "end": 41.62,
  "text": "التالي وسط الغابة مصابة"
 },
 {
  "start": 41.64,
  "end": 43.34,
  "text": "بكسر في عظمة الترقوة"
 },
 {
  "start": 43.36,
  "end": 45.48,
  "text": "وجروح في جسدها كانت"
 },
 {
  "start": 45.5,
  "end": 48.12,
  "text": "والدتها مفقودة والطائرة تحطمت"
 },
 {
  "start": 48.14,
  "end": 49.34,
  "text": "ولم يكن حولها أحد"
 },
 {
  "start": 49.36,
  "end": 51.36,
  "text": "لكنها تذكرت نصيحة"
 },
 {
  "start": 51.38,
  "end": 52.12,
  "text": "والدها"
 }
]